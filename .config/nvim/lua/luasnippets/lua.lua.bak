local autosnippet = require("luasnip").extend_decorator.apply(s, { snippetType = "autosnippet" })

return {
  -- -- format snippet
  --
  -- -- simple text snippet
  --
  -- s("snipt", fmta([[<>(<>, <>)]], { c(1, { t("s"), t("autosnippet") }), i(2), i(3) })),
  --

  s(
    "snipf",
    fmta(
      [[ 
    <>({ trig='<>', name='<>', dscr='<>'},
    fmta(<>,
    { <> }
    )<>)<>,]],
      {
        c(1, { t("s"), t("autosnippet") }),
        i(2, "trig"),
        i(3, "trig"),
        i(4, "dscr"),
        i(5, "fmt"),
        i(6, "inputs"),
        i(7, "opts"),
        i(0),
      }
    )
  ),
  -- simple text snippet
  s(
    "snipt",
    fmta(
      [[ 
    <>(<>, {t('<>')}<>
    <>)<>,]],
      {
        c(1, { t("s"), t("autosnippet") }),
        c(2, { i(nil, "trig"), sn(nil, { t("{trig='"), i(1), t("'}") }) }),
        i(3, "text"),
        i(4, "opts"),
        i(5),
        i(0),
      }
    )
  ),
}
